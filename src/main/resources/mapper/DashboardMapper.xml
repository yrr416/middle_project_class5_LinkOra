<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.study.project05class.dashboard.mapper.DashboardMapper">

    <!--
        ================================================
         대시보드 전용 SQL 모음
        ================================================
        [실제 DB 테이블 구조 기준]
          reservation : r_idx, u_idx, s_idx,
                        r_start_time(DATETIME), r_end_time(DATETIME),
                        r_total_price(INT), r_status(ENUM 'PENDING',...),
                        r_created(DATETIME)
                        r_status 값 예시: 'PENDING','CONFIRMED','USING','COMPLETED','CANCELLED'

          space       : s_idx, b_idx, s_type, s_name, s_price(INT),
                        s_max_capacity, s_description, s_img, s_created

          inquiries   : i_idx, u_idx, i_category, i_title,
                        i_status(VARCHAR DEFAULT 'PENDING'), i_content,
                        i_created(DATETIME)

          user        : u_idx, u_id, u_role, u_name, u_pwd, u_email,
                        u_addr, u_phone, u_created(DATE), u_active(INT)
        ================================================
    -->


    <!-- ═══════════════════════════════════════
         요약 카드용 단일 수치 조회
         ═══════════════════════════════════════ -->

    <!-- 오늘 예약 건수 (r_start_time 기준 날짜 비교, 취소 제외) -->
    <select id="getTodayReserveCnt" resultType="int">
        SELECT COUNT(*)
          FROM reservation
         WHERE DATE(r_start_time) = CURDATE()
           AND r_status != 'CANCELLED'
    </select>

    <!-- 전일(어제) 예약 건수 — 전일 대비 변화율 계산용 -->
    <select id="getYesterdayReserveCnt" resultType="int">
        SELECT COUNT(*)
          FROM reservation
         WHERE DATE(r_start_time) = DATE_SUB(CURDATE(), INTERVAL 1 DAY)
           AND r_status != 'CANCELLED'
    </select>

    <!-- 전체 정상 회원 수 (u_active = 0 이 정상, 1 은 숨김) -->
    <select id="getTotalUserCnt" resultType="int">
        SELECT COUNT(*)
          FROM user
         WHERE u_active = 0
    </select>

    <!-- 이번달 신규 가입 회원 수 (u_created 는 DATE 타입) -->
    <select id="getNewUserCnt" resultType="int">
        SELECT COUNT(*)
          FROM user
         WHERE YEAR(u_created)  = YEAR(CURDATE())
           AND MONTH(u_created) = MONTH(CURDATE())
           AND u_active = 0
    </select>

    <!--
        이번달 누적 매출
        - reservation.r_total_price 를 직접 합산 (예약 시점에 계산된 금액)
    -->
    <select id="getMonthlyRevenue" resultType="long">
        SELECT IFNULL(SUM(r_total_price), 0)
          FROM reservation
         WHERE YEAR(r_start_time)  = YEAR(CURDATE())
           AND MONTH(r_start_time) = MONTH(CURDATE())
           AND r_status != 'CANCELLED'
    </select>

    <!--
        현재 이용 중인 공간 수
        - r_start_time <= NOW() <= r_end_time 범위에 해당하는 예약 공간을 집계
        - 취소·대기(PENDING) 제외, CONFIRMED·USING 등 활성 상태만 포함
    -->
    <select id="getActiveSpaceCnt" resultType="int">
        SELECT COUNT(DISTINCT s_idx)
          FROM reservation
         WHERE r_start_time &lt;= NOW()
           AND r_end_time   &gt;= NOW()
           AND r_status NOT IN ('CANCELLED', 'PENDING')
    </select>

    <!--
        미처리 문의 건수
        - 테이블명: inquiries (복수형)
        - i_status = 'PENDING' 이 미처리 상태
    -->
    <select id="getPendingInquiryCnt" resultType="int">
        SELECT COUNT(*)
          FROM inquiries
         WHERE i_status = 'PENDING'
    </select>


    <!-- ═══════════════════════════════════════
         차트용 목록 조회
         ═══════════════════════════════════════ -->

    <!--
        월별 매출 추이 (최근 6개월)
        반환 컬럼: month(VARCHAR "yyyy-MM"), revenue(BIGINT)
        r_start_time 기준 월로 그룹핑, r_total_price 합산
    -->
    <select id="getMonthlySales" resultType="map">
        SELECT
            DATE_FORMAT(r_start_time, '%Y-%m') AS month,
            IFNULL(SUM(r_total_price), 0)      AS revenue
          FROM reservation
         WHERE r_start_time >= DATE_FORMAT(DATE_SUB(CURDATE(), INTERVAL 5 MONTH), '%Y-%m-01')
           AND r_status != 'CANCELLED'
         GROUP BY DATE_FORMAT(r_start_time, '%Y-%m')
         ORDER BY month ASC
    </select>

    <!--
        공간별 이용률 (최근 3개월, 상위 8개)
        반환 컬럼: spacename(VARCHAR), usagecount(BIGINT)
        취소 제외한 전체 예약 건수 기준
    -->
    <select id="getSpaceUsage" resultType="map">
        SELECT
            s.s_name       AS spacename,
            COUNT(r.r_idx) AS usagecount
          FROM reservation r
          JOIN space s ON r.s_idx = s.s_idx
         WHERE r.r_start_time >= DATE_SUB(NOW(), INTERVAL 3 MONTH)
           AND r.r_status != 'CANCELLED'
         GROUP BY s.s_idx, s.s_name
         ORDER BY usagecount DESC
         LIMIT 8
    </select>

    <!--
        요일별 예약 히트맵 (이번달 기준)
        반환 컬럼:
          weeknum    : 이번달 내 몇째 주 (1부터 시작)
          dayofweek  : 요일 번호 (1=일요일 ~ 7=토요일, MySQL DAYOFWEEK 기준)
          reservecnt : 예약 건수
        r_start_time(DATETIME) 에서 날짜 부분만 추출하여 계산
    -->
    <select id="getWeekdayHeatmap" resultType="map">
        SELECT
            WEEK(r_start_time) - WEEK(DATE_FORMAT(CURDATE(), '%Y-%m-01')) + 1 AS weeknum,
            DAYOFWEEK(r_start_time)                                            AS dayofweek,
            COUNT(*)                                                           AS reservecnt
          FROM reservation
         WHERE YEAR(r_start_time)  = YEAR(CURDATE())
           AND MONTH(r_start_time) = MONTH(CURDATE())
           AND r_status != 'CANCELLED'
         GROUP BY weeknum, DAYOFWEEK(r_start_time)
         ORDER BY weeknum, DAYOFWEEK(r_start_time)
    </select>


    <!-- ═══════════════════════════════════════
         최근 현황 목록 조회
         ═══════════════════════════════════════ -->

    <!--
        최근 예약 5건
        - r_start_time 을 날짜 문자열로 포맷하여 r_date 로 반환
        - r_total_price 를 r_price 로 별칭하여 RecentReserveVO 에 매핑
        - r_created 내림차순 정렬 (가장 최근 생성 순)
    -->
    <select id="getRecentReserves"
            resultType="org.study.project05class.dashboard.vo.RecentReserveVO">
        SELECT
            r.r_idx,
            u.u_name,
            s.s_name,
            DATE_FORMAT(r.r_start_time, '%Y-%m-%d') AS r_date,
            r.r_status,
            r.r_total_price                          AS r_price
          FROM reservation r
          JOIN user  u ON r.u_idx = u.u_idx
          JOIN space s ON r.s_idx = s.s_idx
         ORDER BY r.r_created DESC
         LIMIT 5
    </select>

    <!--
        신규 가입 회원 목록 (정상 계정 중 가장 최근 5명)
        CustomerVO 는 기존 타입 별칭(customer.vo 패키지) 그대로 사용
    -->
    <select id="getNewUsers" resultType="CustomerVO">
        SELECT
            u_idx,
            u_name,
            u_email,
            u_created,
            u_role
          FROM user
         WHERE u_active = 0
         ORDER BY u_created DESC
         LIMIT 5
    </select>

</mapper>
