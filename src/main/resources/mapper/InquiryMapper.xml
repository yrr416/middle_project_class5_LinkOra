<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.study.project05class.inquiry.mapper.InquiryMapper">

    <!-- ─────────────────────────────────────────────────────────────
         공통 검색 조건
         ───────────────────────────────────────────────────────────── -->
    <sql id="inquirySearchCondition">
        <where>
            <!-- 상태 필터: PENDING(미답변) / COMPLETE(답변완료) / ""(전체) -->
            <if test="inquiryVO.status_filter != null and inquiryVO.status_filter != ''">
                i.i_status = #{inquiryVO.status_filter}
            </if>
            <!-- 제목 또는 작성자명 검색 -->
            <if test="inquiryVO.search_word != null and inquiryVO.search_word != ''">
                AND (i.i_title LIKE CONCAT('%', #{inquiryVO.search_word}, '%')
                  OR u.u_name  LIKE CONCAT('%', #{inquiryVO.search_word}, '%'))
            </if>
        </where>
    </sql>

    <!-- ─────────────────────────────────────────────────────────────
         전체 문의 수
         ───────────────────────────────────────────────────────────── -->
    <select id="getInquiryCount" parameterType="map" resultType="int">
        SELECT COUNT(*)
          FROM inquiries i
          LEFT JOIN user u ON i.u_idx = u.u_idx
        <include refid="inquirySearchCondition"/>
    </select>

    <!-- ─────────────────────────────────────────────────────────────
         문의 목록 조회
         - 미답변(PENDING) 우선 정렬 → 최신 문의 순
         ───────────────────────────────────────────────────────────── -->
    <select id="getInquiryList" parameterType="map" resultType="InquiryVO">
        SELECT i.i_idx,
               i.u_idx,
               u.u_name,
               i.i_category,
               i.i_title,
               i.i_status,
               DATE_FORMAT(i.i_created,  '%Y-%m-%d %H:%i') AS i_created,
               DATE_FORMAT(i.i_answered, '%Y-%m-%d %H:%i') AS i_answered
          FROM inquiries i
          LEFT JOIN user u ON i.u_idx = u.u_idx
        <include refid="inquirySearchCondition"/>
         ORDER BY
            /* 미답변(PENDING) 먼저, 그 다음 최신순 */
            CASE WHEN i.i_status = '대기중' THEN 0 ELSE 1 END ASC,
            i.i_created DESC
         LIMIT #{numPerPage} OFFSET #{offset}
    </select>

    <!-- ─────────────────────────────────────────────────────────────
         문의 단건 상세 조회 (답변 포함)
         ───────────────────────────────────────────────────────────── -->
    <select id="getInquiryDetail" parameterType="String" resultType="InquiryVO">
        SELECT i.i_idx,
               i.u_idx,
               u.u_name,
               i.i_category,
               i.i_title,
               i.i_status,
               i.i_content,
               i.i_file_url,
               i.i_answer,
               DATE_FORMAT(i.i_created,  '%Y-%m-%d %H:%i') AS i_created,
               DATE_FORMAT(i.i_answered, '%Y-%m-%d %H:%i') AS i_answered
          FROM inquiries i
          LEFT JOIN user u ON i.u_idx = u.u_idx
         WHERE i.i_idx = #{i_idx}
    </select>

    <!-- ─────────────────────────────────────────────────────────────
         답변 저장 + 상태 자동 변경
         - i_answer  : 관리자가 입력한 답변 내용
         - i_status  : 대기중 → 답변완료 (자동 변경)
         - i_answered: 답변 저장 시각 자동 기록 (NOW())
         ───────────────────────────────────────────────────────────── -->
    <update id="saveAnswer" parameterType="map">
        UPDATE inquiries
           SET i_answer   = #{i_answer},
               i_status   = '답변완료',
               i_answered = NOW()
         WHERE i_idx = #{i_idx}
    </update>

    <!-- ─────────────────────────────────────────────────────────────
         미답변 문의 수 (대시보드 알림용)
         ───────────────────────────────────────────────────────────── -->
    <select id="getPendingCount" resultType="int">
        SELECT COUNT(*) FROM inquiries WHERE i_status = '대기중'
    </select>

</mapper>
