<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.study.midproject.inquiry.mapper.InquiryMapper">

    <!-- ResultMap for InquiryVO (Explicit Mapping) -->
    <resultMap id="inquiryResultMap" type="org.study.midproject.inquiry.vo.InquiryVO">
        <id property="idx" column="i_idx" />
        <result property="userIdx" column="u_idx" />
        <result property="category" column="i_category" />
        <result property="title" column="i_title" />
        <result property="status" column="i_status" />
        <result property="content" column="i_content" />
        <result property="fileUrl" column="i_file_url" />
        <result property="answer" column="i_answer" />
        <result property="createdAt" column="i_created" />
        <result property="answeredAt" column="i_answered" />
    </resultMap>

    <!-- 신규 문의 등록 -->
    <insert id="insertInquiry" parameterType="org.study.midproject.inquiry.vo.InquiryVO">
        INSERT INTO inquiries (
            u_idx, i_category, i_title, i_content, i_status, i_created
        ) VALUES (
            #{userIdx}, #{category}, #{title}, #{content}, '대기중', DATE_FORMAT(NOW(), '%Y.%m.%d %H:%i:%s')
        )
    </insert>

    <!-- 특정 사용자의 문의 내역 리스트 조회 -->
    <select id="selectInquiryListByUser" parameterType="int" resultMap="inquiryResultMap">
        SELECT 
            i_idx, u_idx, i_category, i_title, i_status, 
            DATE_FORMAT(i_created, '%Y.%m.%d') AS i_created
        FROM inquiries 
        WHERE u_idx = #{userIdx}
        ORDER BY i_created DESC
    </select>

    <!-- 특정 문의 상세 내용 및 관리자 답변 조회 -->
    <select id="selectInquiryDetail" parameterType="int" resultMap="inquiryResultMap">
        SELECT 
            i_idx, u_idx, i_category, i_title, i_content, i_status, i_answer, 
            DATE_FORMAT(i_created, '%Y.%m.%d %H:%i') AS i_created,
            DATE_FORMAT(i_answered, '%Y.%m.%d %H:%i') AS i_answered
        FROM inquiries 
        WHERE i_idx = #{idx}
    </select>

</mapper>
