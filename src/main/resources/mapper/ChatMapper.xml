<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.study.project05.chat.mapper.ChatMapper">

    <!-- 결과 매핑 (DB 컬럼 -> VO 카멜케이스) -->
    <resultMap id="ChatResultMap" type="org.study.project05.chat.vo.ChatVO">
        <id property="chatIdx" column="c_idx" />
        <result property="userIdx" column="u_idx" />
        <result property="chatSession" column="c_session" />
        <result property="chatMessage" column="c_message" />
        <result property="chatResponse" column="c_response" />
        <result property="chatIntent" column="c_intent" />
        <result property="chatPage" column="c_page" />
        <result property="chatTime" column="c_time" />
    </resultMap>

    <!-- 새로운 대화 저장 -->
    <insert id="insertChat" parameterType="org.study.project05.chat.vo.ChatVO" useGeneratedKeys="true" keyProperty="chatIdx">
        INSERT INTO chatbot (
            u_idx, c_session, c_message, c_response, c_intent, c_page, c_time
        ) VALUES (
            #{userIdx}, #{chatSession}, #{chatMessage}, #{chatResponse}, #{chatIntent}, #{chatPage}, NOW()
        )
    </insert>

    <!-- 세션별 대화 내역 조회 -->
    <select id="selectChatListBySession" parameterType="int" resultMap="ChatResultMap">
        SELECT 
            c_idx, u_idx, c_session, c_message, c_response, c_intent, c_page, c_time
        FROM chatbot
        WHERE c_session = #{chatSession}
        ORDER BY c_idx ASC
    </select>

    <!-- 사용자별 최근 대화 10개 조회 (과거 이력 불러오기용) -->
    <select id="selectRecentChatByUser" parameterType="long" resultMap="ChatResultMap">
        SELECT * FROM (
            SELECT 
                c_idx, u_idx, c_session, c_message, c_response, c_intent, c_page, c_time
            FROM chatbot
            WHERE u_idx = #{userIdx}
            ORDER BY c_idx DESC
            LIMIT 10
        ) sub
        ORDER BY c_idx ASC
    </select>

</mapper>
